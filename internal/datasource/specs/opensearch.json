{
  "type": "opensearch",
  "aliases": [
    "open-search",
    "amazon-opensearch",
    "aws-opensearch"
  ],
  "displayName": "OpenSearch",
  "group": "search",
  "order": 20,
  "defaultPort": 9200,
  "wire": "http",
  "dialect": "opensearch",
  "ddlDialect": "elasticsearch",
  "family": "elasticsearch",
  "objectKind": "index",
  "caseSensitiveIdentifiers": true,
  "protection": true,
  "agent": {
    "buildTag": "gonavi_opensearch_driver",
