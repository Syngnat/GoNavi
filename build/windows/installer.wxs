<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="$(var.ProductName)"
           Manufacturer="Syngnat"
           Language="1033"
           Version="$(var.ProductVersion)"
           ProductCode="*"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade AllowDowngrades="yes"
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="GoNaviIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GoNaviIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Syngnat/GoNavi" />
    <!-- Channel switches and dev builds may install an executable with a lower or equal file version.
         Always replace installer-owned files instead of leaving a related product's key path in place. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="SqlFileAssociationComponent" />
    </Feature>


    <!-- Open With / double-click support for .sql files. Machine-wide because
         the package is perMachine; uninstall removes the keys it owns. -->
    <Component Id="SqlFileAssociationComponent"
               Directory="INSTALLFOLDER"
               Guid="6E4B8C1D-3A7F-4E52-9B0C-7D1E5A2F8C64"
               Bitness="always64">
      <RegistryKey Root="HKLM" Key="Software\Classes\.sql">
        <RegistryValue Type="string" Value="GoNavi.SQLFile" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Classes\GoNavi.SQLFile">
        <RegistryValue Type="string" Value="SQL File" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]GoNavi.exe,0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]GoNavi.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>
    <Component Id="MainExecutable"
               Directory="INSTALLFOLDER"
               Guid="$(var.ComponentGuid)"
               Bitness="always64">
      <File Id="GoNaviExe"
            Source="$(var.SourceExe)"
            Name="GoNavi.exe"
            KeyPath="yes">
        <!-- Give a fresh install a real icon before GoNavi has launched and rewritten the
             shortcut to the user's content-addressed ICO. Runtime brand switches replace
             IconLocation with that stable per-user path. -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="$(var.ProductName)"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="GoNaviIcon"
                  Advertise="no">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Syngnat.GoNavi" />
        </Shortcut>
      </File>
      <File Id="GoNaviMsiInstallMarker"
            Source="$(var.InstallMarker)"
            Name=".gonavi-msi-install" />
      <File Id="GoNaviApplyBrandIconScript"
            Source="$(var.ApplyBrandIconScript)"
            Name="apply-brand-icon.ps1" />
      <File Id="GoNaviLicense"
            Source="$(var.LicenseFile)"
            Name="LICENSE.txt" />
      <File Id="GoNaviNotice"
            Source="$(var.NoticeFile)"
            Name="NOTICE.txt" />
      <RegistryValue Root="HKLM"
                     Key="Software\Syngnat\$(var.RegistryKeyName)"
                     Name="InstallType"
                     Value="MSI"
                     Type="string"
                     KeyPath="no" />
      <RegistryValue Root="HKLM"
                     Key="Software\Syngnat\$(var.RegistryKeyName)"
                     Name="InstallPath"
                     Value="[INSTALLFOLDER]GoNavi.exe"
                     Type="string"
                     KeyPath="no" />
    </Component>

    <!-- Online updates pass the user's pre-update desktop shortcut state. Keeping this resource
         in its own component lets a major upgrade remove an unwanted old shortcut without
         recreating it, while first-time and manual installs retain the existing default. -->
    <Component Id="DesktopShortcutComponent"
               Directory="DesktopFolder"
               Guid="$(var.DesktopShortcutComponentGuid)"
               Bitness="always64"
               Condition="INSTALLDESKTOPSHORTCUT = 1">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.ProductName)"
                Target="[#GoNaviExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="GoNaviIcon"
                Advertise="no">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="Syngnat.GoNavi" />
      </Shortcut>
      <RegistryValue Root="HKLM"
                     Key="Software\Syngnat\$(var.RegistryKeyName)"
                     Name="DesktopShortcutInstalled"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_InstallDir"
              InstallDirectory="INSTALLFOLDER"
              ExtendedPathValidation="yes" />

    <!-- Brand icon switching rewrites the IconLocation of the GoNavi shortcuts at
         run time with standard user privileges. Explorer anchors the taskbar
         button to the IconLocation of the shortcut resolved through the
         AppUserModel.ID, so a read-only shortcut freezes the button on a stale
         brand icon and leaves the desktop and Start Menu entries behind while
         every other surface updates ("shortcut is not writable", observed on
         Windows 11 26200). Grant Users modify on exactly these two
         installer-owned .lnk files after they are created - never on the
         containing directories - so runtime switches can update them. -->
    <!-- Data pass to the deferred actions follows the documented pattern: an
         immediate type 51 scheduled in the execute sequence formats the
         icacls command line (directory properties resolve at script
         generation) into a property write that lands in the execution
         script; the deferred type 18 then expands it as its
         CustomActionData. Granting requires the elevated, deferred context. -->
    <CustomAction Id="SetGrantUsersModifyStartMenuShortcutCmd"
                  Property="GrantUsersModifyStartMenuShortcut"
                  Value="&quot;[SystemFolder]icacls.exe&quot; &quot;[ProgramMenuFolder]$(var.ProductName).lnk&quot; /grant *S-1-5-32-545:M" />
    <CustomAction Id="GrantUsersModifyStartMenuShortcut"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="[GrantUsersModifyStartMenuShortcut]" />
    <CustomAction Id="SetGrantUsersModifyDesktopShortcutCmd"
                  Property="GrantUsersModifyDesktopShortcut"
                  Value="&quot;[SystemFolder]icacls.exe&quot; &quot;[DesktopFolder]$(var.ProductName).lnk&quot; /grant *S-1-5-32-545:M" />
    <CustomAction Id="GrantUsersModifyDesktopShortcut"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="[GrantUsersModifyDesktopShortcut]" />
    <!-- Restore the previously selected brand icon at install time. The
         selection survives uninstall inside the user's data root, but the
         in-app restore only runs once GoNavi launches - without this action a
         reinstall shows the default icon until the first start. The immediate
         action formats the command line (user profile paths resolve at script
         generation); the deferred SYSTEM action runs the installed script
         against the freshly created shortcuts. Failures are ignored: a fresh
         machine without persisted state keeps the default icon. The "."
         appended to [AppDataFolder] is load-bearing: the property ends with a
         backslash, and a raw "...\Roaming\" inside quotes makes the closing
         quote an escaped one that swallows every remaining argument. -->
    <CustomAction Id="SetApplyPersistedBrandIconCmd"
                  Property="ApplyPersistedBrandIcon"
                  Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]apply-brand-icon.ps1&quot; -ApplicationDataFolder &quot;[AppDataFolder].&quot; -StartMenuShortcut &quot;[ProgramMenuFolder]$(var.ProductName).lnk&quot; -DesktopShortcut &quot;[DesktopFolder]$(var.ProductName).lnk&quot;" />
    <CustomAction Id="ApplyPersistedBrandIcon"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="[ApplyPersistedBrandIcon]" />
    <!-- Remove the app's user-layer leftovers on a genuine uninstall: the
         startup migration moves the machine Start Menu shortcut into the user
         profile, so MSI RemoveFiles never sees it, and the taskbar pin keeps
         launching the uninstalled executable. UPGRADINGPRODUCTCODE keeps this
         off the major-upgrade teardown so an update never unpins the user or
         deletes their migrated shortcuts. The action runs before file removal
         so the installed script and the executable it matches against still
         exist. -->
    <CustomAction Id="SetUninstallBrandCleanupCmd"
                  Property="UninstallBrandCleanup"
                  Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]apply-brand-icon.ps1&quot; -UninstallCleanup -ApplicationDataFolder &quot;[AppDataFolder].&quot; -ExpectedTarget &quot;[INSTALLFOLDER]GoNavi.exe&quot;" />
    <CustomAction Id="UninstallBrandCleanup"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="[UninstallBrandCleanup]" />
    <InstallExecuteSequence>
      <Custom Action="SetGrantUsersModifyStartMenuShortcutCmd" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="GrantUsersModifyStartMenuShortcut" Before="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="SetGrantUsersModifyDesktopShortcutCmd" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="GrantUsersModifyDesktopShortcut" Before="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="SetApplyPersistedBrandIconCmd" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="ApplyPersistedBrandIcon" Before="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="SetUninstallBrandCleanupCmd" After="InstallValidate" Condition="REMOVE AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UninstallBrandCleanup" After="InstallInitialize" Condition="REMOVE AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>
</Wix>
