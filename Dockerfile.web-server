# syntax=docker/dockerfile:1.7
#
# GoNavi Web Server（浏览器访问版）镜像。
# 复用主程序 web-server 模式 + 嵌入 frontend/dist，不依赖桌面 WebView/CGO。

FROM --platform=$BUILDPLATFORM node:20-bookworm AS frontend

# 使用 monorepo 布局：frontend 源码通过相对路径 ../../../shared/i18n 引用仓库 shared/
# （见 frontend/src/i18n/catalog.ts、shared/i18n/messages.ts、shared/i18n/translate.ts）。
# 仅 COPY frontend/ 会导致 tsc 报 Cannot find module '../../../shared/i18n/*'。
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/patches ./patches
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
COPY shared/ /src/shared/
# The frontend also imports the backend-owned capability registry so both
# runtimes use the same support matrix.
COPY internal/db/data_source_capability_contract.json /src/internal/db/data_source_capability_contract.json
# 用户管理选项契约同理：前端标签覆盖测试直接引用后端的选项 ID 清单，tsc 会编译测试文件。
COPY internal/dbuser/option_contract.json /src/internal/dbuser/option_contract.json
# wailsjs 绑定已入库；容器内只构建静态前端
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH
# 版本号必须注入，否则 AppVersion 恒为编译期默认值 0.0.0：运行镜像只 COPY 了
# 二进制、没有 version/dev-version.txt 与 frontend/package.json，getCurrentVersion()
# 拿不到任何回退值，currentDriverReleaseTag() 会返回空 tag，驱动下载通道从
# dev-latest 退化为 releases/latest（当前 v0.9.8），与本次构建现场生成的内嵌
# revision 必然不匹配，驱动永远装不上。
#
# 默认值刻意取 dev-local：本地 `up --build` 不带 build-arg 时必须落在开发通道
# （isDevelopmentDriverReleaseVersion 认 -dev/-test/-local/-snapshot 后缀）。
# 不能照抄 Dockerfile.cli 的 ARG VERSION=dev——裸 "dev" 不匹配任何后缀，
# 会被判为正式版并拼出 "vdev" 这个不存在的 tag。
ARG VERSION=dev-local

WORKDIR /src

COPY go.mod go.sum ./
COPY third_party/highgo-pq/go.mod ./third_party/highgo-pq/go.mod
COPY third_party/go-irisnative/go.mod third_party/go-irisnative/go.sum ./third_party/go-irisnative/
RUN go mod download

COPY . .
RUN ./tools/generate-driver-agent-revisions.sh --platform "${TARGETOS}/${TARGETARCH}"

# catalog.zip 是提交进 git 的派生物，二进制无法参与三方合并；合并后与 JSON 源
# 文件漂移会让 Go 侧 T() 返回裸 key。构建前强制重新生成，与 wails preBuildHook、
# CI 的 go build 环节保持同一策略。
RUN go generate ./shared/i18n
COPY --from=frontend /src/frontend/dist ./frontend/dist
# 主程序以 tar.br 固实压缩形态嵌入前端产物,与 frontend/dist 一样在 frontend 阶段新鲜构建
COPY --from=frontend /src/frontend/dist.tar.br ./frontend/dist.tar.br

# 纯 Go 构建主程序（web-server 模式不需要 Wails WebView / CGO）
# -X 与 build-release.sh 的 LDFLAGS 保持同一注入点，保证容器内版本号、
# 更新检查与驱动发布通道判定三者一致。
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w -X GoNavi-Wails/internal/app.AppVersion=${VERSION}" -o /out/gonavi .

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /var/lib/gonavi --uid 10001 gonavi \
    && mkdir -p /data /var/lib/gonavi/logs /usr/share/doc/gonavi \
    && chown -R gonavi:gonavi /data /var/lib/gonavi

COPY --from=builder /out/gonavi /usr/local/bin/gonavi
COPY --from=builder /src/LICENSE /usr/share/doc/gonavi/LICENSE
COPY --from=builder /src/NOTICE /usr/share/doc/gonavi/NOTICE

ENV HOME=/var/lib/gonavi \
    GONAVI_DATA_ROOT=/data \
    GONAVI_LOG_DIR=/var/lib/gonavi/logs \
    GONAVI_WEB_ADDR=0.0.0.0:34116

VOLUME ["/data"]
EXPOSE 34116

USER gonavi

# 未通过环境变量配置密码时，首次访问 /setup 初始化；认证状态落在数据目录 web_auth.json
ENTRYPOINT ["/usr/local/bin/gonavi"]
CMD ["web-server"]
