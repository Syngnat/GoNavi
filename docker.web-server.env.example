# 宿主机 GoNavi 活动数据目录。
# 建议至少包含：connections.json、daily_secrets.json；
# 如需可选驱动代理，一并挂载 drivers/。
# Web 认证状态会写入 web_auth.json；未设置环境密码时首次访问 /setup 初始化。
GONAVI_HOST_DATA_ROOT=/absolute/path/to/gonavi-data

# 预构建镜像地址。稳定版通常使用 latest，跟随 dev 分支可改成 ghcr.io/syngnat/gonavi-web-server:dev-latest
GONAVI_WEB_IMAGE=ghcr.io/syngnat/gonavi-web-server:latest

# 预构建镜像拉取策略：always / missing / never
GONAVI_WEB_PULL_POLICY=missing

# 宿主机暴露端口（映射到容器 34116）
GONAVI_WEB_HTTP_PORT=34116

# Web 管理员密码（至少 6 位）。留空时首次访问 /setup 初始化；公网部署请使用更强密码。
# 设置或修改后请执行 docker compose up -d --force-recreate；请限制本文件的读取权限。
# 新部署如需启用 2FA，请先留空并通过 /setup 初始化，再设置为同一密码并重新创建容器。
GONAVI_WEB_PASSWORD=

# Go 堆内存软上限（传给运行时的 GOMEMLIMIT）。GC 在逼近该值时会更积极回收，
# 用于压低常驻内存；默认 112MiB 适合单管理员、少量连接的部署。保存了大量
# 连接元数据或频繁做大结果集导出时请调大（例如 400MiB）。设得过低不会 OOM，
# 但 GC 会持续空转吃 CPU——出现 CPU 异常升高时优先调大这个值。
GONAVI_WEB_GOMEMLIMIT=112MiB

# 可选：允许已认证的浏览器会话管理插件（安装、启停、替换、移除、读取技能文档）。
# 默认 0（只读）。设为 1 后，任何已认证会话都能让服务器安装并执行插件代码；
# 仅在单一管理员、可信网络下开启，并在反向代理层限制访问。
GONAVI_WEB_PLUGIN_MANAGEMENT=0

# 可信反向代理的 IP / CIDR 列表（逗号分隔）。仅当直连对端命中该列表时，
# 登录限流与失败锁定才会采信 X-Forwarded-For 里的客户端地址。
# 留空（默认）时一律以不可伪造的直连对端地址为准——该头完全由客户端控制，
# 无条件采信会让攻击者逐请求更换该头即绕过 5 次失败锁定。
# 若本服务部署在 Nginx/Traefik/负载均衡之后，请填写这些代理的地址，
# 否则所有客户端会共用同一个限流桶。例：GONAVI_WEB_TRUSTED_PROXIES=10.0.0.0/8,172.18.0.1
GONAVI_WEB_TRUSTED_PROXIES=
