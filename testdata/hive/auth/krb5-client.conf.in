[libdefaults]
 default_realm = GONAVI.TEST
 dns_lookup_kdc = false
 dns_lookup_realm = false
 rdns = false
 udp_preference_limit = 1
 ticket_lifetime = 1h
 forwardable = false

[realms]
 GONAVI.TEST = {
  kdc = 127.0.0.1:@KDC_PORT@
  kpasswd_server = 127.0.0.1:@KPASSWD_PORT@
 }

[domain_realm]
 .gonavi.test = GONAVI.TEST
 gonavi.test = GONAVI.TEST
