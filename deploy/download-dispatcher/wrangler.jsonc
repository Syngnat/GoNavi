{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gonavi-download-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "download-dispatch.syngnat.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
